{
  "name": "fulldeck-backend",
  "version": "1.0.0",
  "description": "Backend for fulldeck gaming platform",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "local": "nodemon app.js",
    "setup": "npm run db:start && npm run db:generate && npm run db:migrate",
    "db:start": "cd database && docker-compose up -d",
    "db:generate": "prisma generate --schema=database/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=database/schema.prisma",
    "db:push": "prisma db push --schema=database/schema.prisma",
    "db:studio": "prisma studio --schema=database/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0",
    "winston": "^3.17.0",
    "winston-cloudwatch": "^6.3.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.15.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
